def Erdos848.OriginalProblem848Statement : ℕ → Prop :=
fun N => ∀ A ⊆ Finset.Icc 1 N, Erdos848.NonSquarefreeProductProp A → A.card ≤ {n ∈ Finset.Icc 1 N | n % 25 = 7}.card
def Erdos848.NonSquarefreeProductProp : Finset ℕ → Prop :=
fun A => ∀ a ∈ A, ∀ b ∈ A, ¬Squarefree (a * b + 1)
